# Skopiuj do backend/.env i uzupełnij wartości.
# Plik .env NIGDY nie trafia do gita.

# Hasło aplikacji Pi-hole (Settings → Web Interface/API → App password).
# NIE używaj głównego hasła panelu.
PIHOLE_APP_PASSWORD=

# Opcjonalna nazwa hosta na pasku górnym (domyślnie: hostname systemu).
# HUB_NAME=mother-base
