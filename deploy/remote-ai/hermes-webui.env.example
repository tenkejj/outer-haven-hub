# Środowisko dla hermes-webui (PC).
# Użycie:  set -a; source hermes-webui.env; set +a; ./start.sh
# albo wpisz do unit / ctl.sh wg dokumentacji upstream.

# OBOWIĄZKOWE zanim wystawisz poza localhost (Hermex / sieć WG):
HERMES_WEBUI_PASSWORD=zmien-na-dlugie-losowe-haslo

# Domyślnie bezpiecznie — tylko loopback:
HERMES_WEBUI_HOST=127.0.0.1
HERMES_WEBUI_PORT=8787

# Backend LLM = lokalny llama-server (gdy Hermes to wspiera w konfiguracji UI):
# OPENAI_BASE_URL=http://127.0.0.1:8081/v1
# OPENAI_API_KEY=local
