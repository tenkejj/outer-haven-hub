# systemd — llama-server na foxhound (nie na Pi)
# Dopasowane do produkcyjnej komendy użytkownika (Qwen3.5-9B Q5_K_M + Hermes).
#
# sudo cp llama-server.env.example /etc/default/llama-server
# sudo cp llama-server.service /etc/systemd/system/
# sudo systemctl daemon-reload && sudo systemctl enable --now llama-server

[Unit]
Description=llama.cpp server (Qwen3.5-9B for Hermes)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tenkej
Group=tenkej
EnvironmentFile=-/etc/default/llama-server
Environment=LLAMA_BIN=/home/tenkej/llama.cpp/build/bin/llama-server
Environment=LLAMA_MODEL=/home/tenkej/Models/Qwen3.5-9B/Qwen3.5-9B-Q5_K_M.gguf
Environment=LLAMA_ALIAS=qwen3.5-9b-q5
Environment=LLAMA_HOST=127.0.0.1
Environment=LLAMA_PORT=8080
Environment=LLAMA_NGL=20
Environment=LLAMA_CTX=65536
Environment=LLAMA_NP=1
Environment=LLAMA_BATCH=512
Environment=LLAMA_UBATCH=128
ExecStart=/bin/sh -c 'exec "${LLAMA_BIN}" \
  -m "${LLAMA_MODEL}" \
  --alias "${LLAMA_ALIAS}" \
  -ngl "${LLAMA_NGL}" \
  -c "${LLAMA_CTX}" \
  -np "${LLAMA_NP}" \
  -b "${LLAMA_BATCH}" \
  -ub "${LLAMA_UBATCH}" \
  -fa on \
  -ctk q8_0 \
  -ctv q8_0 \
  --no-kv-offload \
  --reasoning off \
  --reasoning-budget 0 \
  --host "${LLAMA_HOST}" \
  --port "${LLAMA_PORT}"'
Restart=on-failure
RestartSec=5
Nice=5

# Duży kontekst trzyma KV w RAM — daj zapas limitu adresów.
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
