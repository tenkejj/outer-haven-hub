# /etc/default/llama-server  — kanoniczna komenda foxhound (Hermes + Qwen3.5-9B)
# sudo cp llama-server.env.example /etc/default/llama-server
#
# Uwagi (RTX 3060 Ti 8 GB):
# - -ngl 20 + --no-kv-offload + -c 65536 = świadomy kompromis (duży kontekst, KV na RAM)
# - host 127.0.0.1 = tylko lokalny Hermes / curl; zdalny dostęp idzie przez Caddy na Pi
#   → hermes-webui (nie wystawiaj llama-server na świat)
# - port 8080 na PC ≠ Pi-hole :8080 (inne maszyny)

LLAMA_BIN=/home/tenkej/llama.cpp/build/bin/llama-server
LLAMA_MODEL=/home/tenkej/Models/Qwen3.5-9B/Qwen3.5-9B-Q5_K_M.gguf
LLAMA_ALIAS=qwen3.5-9b-q5

LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080

LLAMA_NGL=20
LLAMA_CTX=65536
LLAMA_NP=1
LLAMA_BATCH=512
LLAMA_UBATCH=128
