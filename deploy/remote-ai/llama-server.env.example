# /etc/default/llama-server  (skopiuj i uzupełnij ścieżki)
# sudo cp llama-server.env.example /etc/default/llama-server

LLAMA_BIN=/home/tenkej/llama.cpp/build/bin/llama-server
LLAMA_MODEL=/home/tenkej/models/qwen-9b-q5_k_m.gguf

# Na start tylko localhost. Po Etapie 1 możesz zmienić na IP interfejsu WG
# albo zostawić 127.0.0.1 i iść przez Caddy.
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8081

# RTX 3060 Ti 8 GB — pełny offload dla ~8–9B Q5
LLAMA_NGL=99
LLAMA_CTX=8192
